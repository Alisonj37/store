{
    "name": "robojacksparrow/robojacksparrow-wp",
    "description": "RoboJackSparrow WP - automacao de conteudo WordPress nativa (scraping, pesquisa em tempo real, IA e publicacao)",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "RoboJackSparrow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoboJackSparrow\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
